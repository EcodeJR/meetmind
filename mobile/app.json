{
  "expo": {
    "name": "Memovoice",
    "slug": "memovoice",
    "scheme": "memovoice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7F4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.memovoice.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Memovoice needs microphone access to record your meetings.",
        "UIBackgroundModes": [
          "audio"
        ],
        "UIUserNotificationSettings": true
      }
    },
    "android": {
      "package": "com.memovoice.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#F7F7F4"
      },
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "memovoice"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Memovoice needs microphone access to record your meetings."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Memovoice needs microphone access to record your meetings."
        }
      ],
      "expo-notifications",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a2c4922b-f4bf-4547-9969-406cdf898fd4"
      }
    }
  }
}
