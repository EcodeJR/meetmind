# Server-only admin configuration. Never prefix these values with NEXT_PUBLIC_.
ADMIN_EMAIL=admin@example.com
# Use a bcrypt hash in production.
ADMIN_PASSWORD=$2b$12$replace_with_a_bcrypt_hash
# At least 32 random characters; used to sign short-lived admin sessions.
ADMIN_JWT_SECRET=replace_with_a_long_random_secret
# Private backend connection used only by /api/admin proxy routes.
RAILWAY_API_URL=https://your-backend.example.com
ADMIN_SECRET_KEY=replace_with_the_backend_admin_secret
