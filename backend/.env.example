# Runtime
NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://localhost:27017/memovoice
CLIENT_URL=http://localhost:8081
ADMIN_URL=http://localhost:3000

# Authentication
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Admin authentication. Use the same ADMIN_JWT_SECRET in the backend and
# memovoice-admin deployment. ADMIN_SECRET_KEY is only for explicitly enabled
# legacy static-key access and must not be used in production by default.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_bcrypt_hash
ADMIN_JWT_SECRET=replace_with_a_long_random_secret
ADMIN_SECRET_KEY=replace_with_a_separate_random_secret
ADMIN_ALLOW_STATIC_KEY=false

# Audio storage and AI processing
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MAX_AUDIO_UPLOAD_MB=50
OPENAI_API_KEY=sk_replace_me
ANTHROPIC_API_KEY=replace_me
GROQ_API_KEY=replace_me
GEMINI_API_KEY=replace_me

# Payments (configure only the provider(s) used by your deployment)
PADDLE_API_KEY=replace_me
PADDLE_PRO_PRICE_ID=replace_me
PADDLE_WEBHOOK_SECRET=replace_me
PADDLE_ENVIRONMENT=sandbox
FLUTTERWAVE_PUBLIC_KEY=replace_me
FLUTTERWAVE_SECRET_KEY=replace_me
FLUTTERWAVE_WEBHOOK_SECRET=replace_me
PRO_PRICE_NGN=9000
PRO_PRICE_USD=12
CURRENCY_NG=NGN
CURRENCY_USD=USD

# Email (Resend, Gmail, or your own email gateway)
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Memovoice <hello@example.com>
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=replace_me
EMAIL_GATEWAY_URL=https://your-email-gateway.example.com
EMAIL_GATEWAY_SECRET=replace_me

# Public sharing. This is the public landing/share-site base URL, not the API URL.
PUBLIC_SHARE_BASE_URL=https://your-landing-page.example.com
WEBHOOK_SECRET=replace_with_a_long_random_secret

# Calendar integrations. Generate INTEGRATION_ENCRYPTION_KEY once with:
# openssl rand -hex 32
# Do not rotate it while integrations with stored tokens exist.
INTEGRATION_ENCRYPTION_KEY=64_character_hexadecimal_key
INTEGRATIONS_STATE_SECRET=replace_with_a_long_random_secret
MOBILE_OAUTH_REDIRECT_URI=memovoice://settings/integrations
GOOGLE_CALENDAR_CLIENT_ID=replace_me
GOOGLE_CALENDAR_CLIENT_SECRET=replace_me
GOOGLE_CALENDAR_REDIRECT_URI=https://your-backend.example.com/api/integrations/oauth/google/callback
MICROSOFT_CALENDAR_CLIENT_ID=replace_me
MICROSOFT_CALENDAR_CLIENT_SECRET=replace_me
MICROSOFT_CALENDAR_REDIRECT_URI=https://your-backend.example.com/api/integrations/oauth/outlook/callback

# The durable processing queue is enabled by default. Keep legacy inline
# processing disabled so the same meeting is never processed twice.
ENABLE_LEGACY_PROCESSOR=false
